# 이 파일을 .env 로 복사한 뒤 값을 채워 사용하세요. (.env 는 gitignore 됨)

# ── Database ─────────────────────────────────────────
# DATABASE_HOST 는 기본값이 없어 미설정 시 부팅이 실패합니다.
DATABASE_HOST=localhost
DATABASE_PORT=5432
RAILS_MAX_THREADS=5
RAILS_MIN_THREADS=5

DEV_DATABASE_USERNAME=postgres
DEV_DATABASE_PASSWORD=
DEV_DATABASE_NAME=template_development

TEST_DATABASE_USERNAME=postgres
TEST_DATABASE_PASSWORD=
TEST_DATABASE_NAME=template_test

# ── Rails ────────────────────────────────────────────
SECRET_KEY_BASE=
RAILS_MASTER_KEY=
RAILS_LOG_LEVEL=info
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Auth (JWT) ───────────────────────────────────────
# JWT_SECRET_KEY는 기본값이 없어 미설정 시 부팅이 실패합니다(UTF-8 32바이트 이상
# 필요). 아래 명령으로 64자(64바이트) hex 문자열을 만들어 채우세요:
#   ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
JWT_SECRET_KEY=
JWT_ISSUER=template-ruby-rails
JWT_AUDIENCE=template-ruby-rails
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=2592000
JWT_LEEWAY_SECONDS=0
REFRESH_SESSION_RETENTION_SECONDS=604800

# ── Background jobs / cache ──────────────────────────
REDIS_URL=redis://localhost:6379/0
ACTIVE_JOB_QUEUE_ADAPTER=sidekiq

# ── App ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ACTIVE_STORAGE_SERVICE=local
PORT=4000
